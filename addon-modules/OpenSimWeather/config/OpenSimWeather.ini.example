;; OpenSimWeather 0.3.3 common configuration example
;;
;; Put this [Weather] section in OpenSim.ini, or in a file explicitly included
;; by OpenSim.ini. Do not place it in Regions.ini.
;;
;; This example contains the settings most region operators normally need.
;; See OpenSimWeather.reference.ini.example and the focused examples for every
;; advanced tuning option. Asset settings use OpenSim asset UUIDs.

[Weather]
    ;; Master switch. Keep false until particle texture UUIDs are configured.
    Enabled = false

    ;; Private non-zero command channel. Channel 0 is rejected.
    CommandChannel = 89
    EstateManagerOnly = true

    ;; CoverageMode chooses how emitters are placed:
    ;;   Region     - fills the whole region with a static grid of emitters.
    ;;                EmitterGrid=0 scales the emitter COUNT to RegionSizeX/
    ;;                RegionSizeY using EmitterSpacingMeters, which keeps each
    ;;                emitter's particle burst radius sane on variable-sized
    ;;                regions. A fixed non-zero EmitterGrid instead scales
    ;;                spacing (and burst radius) up with region size, and
    ;;                radius silently exceeds the viewer's ~50m
    ;;                PSYS_SRC_BURST_RADIUS limit on var regions of 1024m or
    ;;                larger - only use a fixed grid count on legacy 256m
    ;;                regions. Best for small/legacy regions or showcase
    ;;                builds where weather should be visible from anywhere.
    ;;   ActiveArea - only maintains emitters around connected avatars.
    ;;                Cheap regardless of region size; nothing renders where
    ;;                nobody is standing.
    ;;   Wandering  - keeps a fixed-size pool of emitters (WanderingBatchSize)
    ;;                that periodically relocate to new random spots across
    ;;                the region, so weather looks like drifting, patchy
    ;;                cells rather than a uniform static grid. Pool size is
    ;;                independent of region size, so startup stays fast and
    ;;                coverage stays bounded even on very large var regions -
    ;;                the tradeoff is that coverage is probabilistic, not
    ;;                guaranteed everywhere at once. Recommended for large
    ;;                var regions instead of Region coverage.
    CoverageMode = Region
    EmitterGrid = 0
    EmitterSpacingMeters = 24
    EmitterHeight = 18.0
    Intensity = 1.0

    ;; Wandering coverage only. Pool size stays constant regardless of region
    ;; size; WanderingChurnFraction of the pool relocates every
    ;; WanderingRefreshSeconds.
    WanderingBatchSize = 40
    WanderingRefreshSeconds = 20
    WanderingChurnFraction = 0.25

    ;; Upload suitable alpha textures and paste their asset UUIDs here.
    RainTexture =
    StormTexture =
    SnowTexture =
    LightningTexture =

    ;; Particle systems cannot collide with roofs. These options suppress
    ;; covered cells and permit explicit no-weather volumes in complex builds.
    AvoidCoveredAreas = true
    UseExclusionVolumes = true
    ExclusionObjectName = Weather Exclusion
    CleanupGeneratedObjectsOnStartup = true

    ;; Region environment and wind changes are opt-in.
    AdjustEnvironment = false
    AllowPersistentEnvironmentChanges = false
    RestoreCloudsOnClear = true

    AdjustWind = false
    RestoreWindOnClear = true

    ;; Storm effects. Thunder requires a valid uploaded sound UUID.
    LightningEnabled = true
    ThunderEnabled = false
    ThunderSound =

    ;; Automatic cycling and entry messages are opt-in.
    AutoCycleEnabled = false
    AutoCycleHours = 6.0
    AutoCycleChoices = storm,rain,snow,sunny,clear
    SendWeatherIMOnEntry = false

    ;; Experimental temporary terrain overlays are opt-in.
    SurfaceEffectsEnabled = false
