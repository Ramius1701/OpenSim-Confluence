:VERSION 1

BEGIN;

CREATE TABLE IF NOT EXISTS AbuseReports (
	"ReportID" serial NOT NULL,
	"SenderID" uuid NOT NULL,
	"SenderName" varchar(64) NULL,
	"Time" integer NOT NULL,
	"AbuseRegionID" uuid NOT NULL,
	"AbuseRegionName" varchar(45) NULL,
	"AbuserID" uuid NOT NULL,
	"AbuserName" varchar(128) NULL,
	"Category" varchar(45) NULL,
	"CheckFlags" integer NOT NULL,
	"Details" varchar(1280) NULL,
	"ObjectID" uuid NOT NULL,
	"Position" varchar(45) NULL,
	"ReportType" integer NOT NULL,
	"Summary" varchar(4608) NULL,
	"Version" varchar(256) NULL,
	"ImageData" bytea NULL,
	PRIMARY KEY ("ReportID")
);

COMMIT;

:VERSION 2

BEGIN;

-- Admin-tool fields (resolved/assigned tracking) - real, working fields on
-- the C# model since 2026-09-07 (see PROJECT_LOG.md), not present before.
-- Active defaults to true (open) so every existing row backfills as still
-- open rather than silently marked resolved.
ALTER TABLE "AbuseReports"
	ADD COLUMN "Active" boolean NOT NULL DEFAULT true,
	ADD COLUMN "AssignedTo" varchar(128) NULL,
	ADD COLUMN "Notes" varchar(2000) NULL;

COMMIT;
