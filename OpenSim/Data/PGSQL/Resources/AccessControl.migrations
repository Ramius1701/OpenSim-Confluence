:VERSION 1

BEGIN;

CREATE TABLE IF NOT EXISTS banned_macs (
	mac varchar(32) NOT NULL PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS banned_id0s (
	id0 varchar(32) NOT NULL PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS banned_ips (
	ip varchar(15) NOT NULL PRIMARY KEY
);

COMMIT;

:VERSION 2

BEGIN;

CREATE TABLE IF NOT EXISTS banned_ip_ranges (
	start_ip varchar(15) NOT NULL,
	end_ip varchar(15) NOT NULL,
	PRIMARY KEY (start_ip, end_ip)
);

COMMIT;
