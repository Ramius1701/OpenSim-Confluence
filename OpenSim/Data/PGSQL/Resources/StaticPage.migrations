:VERSION 1

BEGIN;

CREATE TABLE IF NOT EXISTS static_pages (
	"ID" varchar(36) NOT NULL PRIMARY KEY,
	"Slug" varchar(64) NOT NULL UNIQUE,
	"Title" varchar(255) NOT NULL,
	"Body" text NOT NULL,
	"Updated" int NOT NULL
);

COMMIT;

:VERSION 2

BEGIN;

ALTER TABLE static_pages ADD COLUMN "ShowInNav" smallint NOT NULL DEFAULT 0;
ALTER TABLE static_pages ADD COLUMN "NavOrder" int NOT NULL DEFAULT 0;
ALTER TABLE static_pages ADD COLUMN "RequiresLogin" smallint NOT NULL DEFAULT 0;
ALTER TABLE static_pages ADD COLUMN "RequiresAdmin" smallint NOT NULL DEFAULT 0;

COMMIT;
