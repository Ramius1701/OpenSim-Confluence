:VERSION 1         # --------------------------

BEGIN;

CREATE TABLE IF NOT EXISTS `UserAlias` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `AliasID` char(36) NOT NULL,
  `UserID` char(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  `Description` varchar(80),
  UNIQUE KEY `Id` (`Id`),
  UNIQUE KEY `AliasID` (`AliasID`),
  KEY `UserID` (`UserID`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

COMMIT;

:VERSION 2         #----- useralias Description to utf8mb4 (emoji/full-Unicode support)
BEGIN;
ALTER TABLE `useralias`
	MODIFY COLUMN `Description` varchar(80) CHARACTER SET utf8mb4 DEFAULT NULL;
COMMIT;
