:VERSION 1 # -----------------

BEGIN;

CREATE TABLE IF NOT EXISTS `static_pages` (
	`ID` VARCHAR(36) NOT NULL,
	`Slug` VARCHAR(64) NOT NULL,
	`Title` VARCHAR(255) NOT NULL,
	`Body` TEXT NOT NULL,
	`Updated` INT NOT NULL,
	PRIMARY KEY (`ID`) USING BTREE,
	UNIQUE INDEX `Slug` (`Slug`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

COMMIT;

:VERSION 2 # -----------------

BEGIN;

ALTER TABLE `static_pages`
	ADD COLUMN `ShowInNav` TINYINT(1) NOT NULL DEFAULT 0,
	ADD COLUMN `NavOrder` INT NOT NULL DEFAULT 0,
	ADD COLUMN `RequiresLogin` TINYINT(1) NOT NULL DEFAULT 0,
	ADD COLUMN `RequiresAdmin` TINYINT(1) NOT NULL DEFAULT 0;

COMMIT;

:VERSION 3 # ----------------- Title/Body to utf8mb4 (emoji/full-Unicode support)

BEGIN;

ALTER TABLE `static_pages`
	MODIFY COLUMN `Title` varchar(255) CHARACTER SET utf8mb4 NOT NULL,
	MODIFY COLUMN `Body` text CHARACTER SET utf8mb4 NOT NULL;

COMMIT;
