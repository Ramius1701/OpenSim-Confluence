:VERSION 1 # -----------------

BEGIN;

CREATE TABLE IF NOT EXISTS `currency_balances` (
	`PrincipalID` VARCHAR(36) NOT NULL,
	`Balance` INT NOT NULL DEFAULT 0,
	PRIMARY KEY (`PrincipalID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

CREATE TABLE IF NOT EXISTS `currency_transactions` (
	`TransactionID` VARCHAR(36) NOT NULL,
	`ToAgent` VARCHAR(36) NOT NULL,
	`FromAgent` VARCHAR(36) NOT NULL,
	`Amount` INT NOT NULL,
	`TransferType` INT NOT NULL,
	`Description` VARCHAR(255) NOT NULL,
	`Created` INT NOT NULL,
	`ToBalance` INT NOT NULL,
	`FromBalance` INT NOT NULL,
	PRIMARY KEY (`TransactionID`) USING BTREE,
	INDEX `ToAgent` (`ToAgent`) USING BTREE,
	INDEX `FromAgent` (`FromAgent`) USING BTREE,
	INDEX `Created` (`Created`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

CREATE TABLE IF NOT EXISTS `currency_purchases` (
	`PurchaseID` VARCHAR(36) NOT NULL,
	`PrincipalID` VARCHAR(36) NOT NULL,
	`IP` VARCHAR(64) NOT NULL,
	`Amount` INT NOT NULL,
	`RealAmount` INT NOT NULL,
	`Created` INT NOT NULL,
	PRIMARY KEY (`PurchaseID`) USING BTREE,
	INDEX `PrincipalID` (`PrincipalID`) USING BTREE,
	INDEX `Created` (`Created`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

COMMIT;
