:VERSION 1

BEGIN TRANSACTION;

CREATE TABLE IF NOT EXISTS static_pages (
	ID varchar(36) NOT NULL PRIMARY KEY,
	Slug varchar(64) NOT NULL UNIQUE,
	Title varchar(255) NOT NULL,
	Body text NOT NULL,
	Updated int NOT NULL
);

COMMIT;

:VERSION 2

BEGIN TRANSACTION;

ALTER TABLE static_pages ADD COLUMN ShowInNav INTEGER NOT NULL DEFAULT 0;
ALTER TABLE static_pages ADD COLUMN NavOrder INTEGER NOT NULL DEFAULT 0;
ALTER TABLE static_pages ADD COLUMN RequiresLogin INTEGER NOT NULL DEFAULT 0;
ALTER TABLE static_pages ADD COLUMN RequiresAdmin INTEGER NOT NULL DEFAULT 0;

COMMIT;
