:VERSION 1

BEGIN TRANSACTION;

CREATE TABLE IF NOT EXISTS experiences (
	public_id CHAR(36) NOT NULL PRIMARY KEY,
	owner_id CHAR(36) NOT NULL,
	name VARCHAR(42) NOT NULL DEFAULT '',
	description VARCHAR(128) NOT NULL DEFAULT '',
	group_id CHAR(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
	logo CHAR(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
	marketplace VARCHAR(256) NOT NULL DEFAULT '',
	slurl VARCHAR(256) NOT NULL DEFAULT '',
	maturity INT NOT NULL DEFAULT 0,
	properties INT NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS experience_permissions (
	experience CHAR(36) NOT NULL,
	avatar CHAR(36) NOT NULL,
	allow BOOLEAN NOT NULL,
	PRIMARY KEY (experience, avatar)
);

CREATE INDEX IF NOT EXISTS experience_permissions_avatar ON experience_permissions (avatar);

CREATE TABLE IF NOT EXISTS experience_kv (
	experience CHAR(36) NOT NULL,
	key VARCHAR(1011) NOT NULL,
	value VARCHAR(4095) NOT NULL DEFAULT '',
	PRIMARY KEY (experience, key)
);

COMMIT;
