:VERSION 1

BEGIN TRANSACTION;

CREATE TABLE IF NOT EXISTS UserAlias (
	Id INTEGER PRIMARY KEY AUTOINCREMENT,
	AliasID varchar(36) NOT NULL UNIQUE,
	UserID varchar(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
	Description varchar(80)
);

CREATE INDEX IF NOT EXISTS idx_useralias_userid ON UserAlias (UserID);

COMMIT;
