:VERSION 1

BEGIN TRANSACTION;

CREATE TABLE IF NOT EXISTS Presence (
	UserID varchar(255) NOT NULL,
	RegionID char(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
	SessionID char(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000' UNIQUE,
	SecureSessionID char(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
	LastSeen timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS Presence_UserID ON Presence(UserID);
CREATE INDEX IF NOT EXISTS Presence_RegionID ON Presence(RegionID);

COMMIT;
