:VERSION 1

BEGIN TRANSACTION;

CREATE TABLE IF NOT EXISTS AbuseReports (
	ReportID INTEGER PRIMARY KEY AUTOINCREMENT,
	SenderID varchar(36) NOT NULL,
	SenderName varchar(64) NULL,
	Time integer NOT NULL,
	AbuseRegionID varchar(36) NOT NULL,
	AbuseRegionName varchar(45) NULL,
	AbuserID varchar(36) NOT NULL,
	AbuserName varchar(128) NULL,
	Category varchar(45) NULL,
	CheckFlags integer NOT NULL,
	Details varchar(1280) NULL,
	ObjectID varchar(36) NOT NULL,
	Position varchar(45) NULL,
	ReportType integer NOT NULL,
	Summary varchar(4608) NULL,
	Version varchar(256) NULL,
	ImageData blob NULL
);

COMMIT;

:VERSION 2

BEGIN TRANSACTION;

-- Admin-tool fields (resolved/assigned tracking) - real, working fields on
-- the C# model since 2026-09-07 (see PROJECT_LOG.md), not present before.
-- Active defaults to 1 (open) so every existing row backfills as still
-- open rather than silently marked resolved.
ALTER TABLE AbuseReports ADD COLUMN Active INTEGER NOT NULL DEFAULT 1;
ALTER TABLE AbuseReports ADD COLUMN AssignedTo varchar(128) NULL;
ALTER TABLE AbuseReports ADD COLUMN Notes varchar(2000) NULL;

COMMIT;
